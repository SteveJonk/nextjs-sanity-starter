# Copy this file to `.env` and fill in your Sanity project id.
# Find it at https://www.sanity.io/manage (or run `npx sanity projects list`).

# Public — ships in the browser bundle, not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-26

# The site's public origin, no trailing slash. Defaults to http://localhost:3000.
# Set it in production: it is what makes OG image URLs, the sitemap and
# robots.txt absolute.
NEXT_PUBLIC_SITE_URL=

# Analytics — both optional. Leave empty and no third-party script is loaded.
# GTM container id, e.g. GTM-XXXXXXX.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# Meta (Facebook) pixel id, e.g. 123456789012345.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Server-only. Needed by `npm run seed` to write documents; not used at runtime.
# Create one at https://www.sanity.io/manage -> API -> Tokens, with Editor rights.
SANITY_API_WRITE_TOKEN=
